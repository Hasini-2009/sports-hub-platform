# ========================================================
# SPORTS HUB PLATFORM - ENVIRONMENT CONFIGURATION
# ========================================================

# General Application Settings
PROJECT_NAME="Sports Hub Platform"
API_V1_PREFIX="/api/v1"
SECRET_KEY="super-secret-jwt-key-min-32-chars-long-change-in-production!"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database & Cache (PostgreSQL 15 & Redis 7)
# Leave unset or empty to use automatic SQLite & In-Memory fallback:
DATABASE_URL="postgresql://sportshub:sportshubpassword@localhost:5432/sportshub_db"
REDIS_URL="redis://localhost:6379/0"

# Modes: mock | live
PAYMENT_MODE="mock"
NOTIFY_MODE="mock"

# AI / Ollama & ChromaDB
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="gemma3:1b"
CHROMA_PERSIST_DIR="./chroma_db"

# Storage
UPLOAD_DIR="./uploads"

# Live Payment Gateways (Only required when PAYMENT_MODE=live)
STRIPE_API_KEY=""
STRIPE_WEBHOOK_SECRET=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
PHONEPE_MERCHANT_ID=""
PHONEPE_SALT_KEY=""
PHONEPE_SALT_INDEX="1"
PHONEPE_ENV="UAT"

# Live Push Notifications (Only required when NOTIFY_MODE=live)
FCM_SERVER_KEY=""
APNS_AUTH_KEY=""

# Frontend Configuration
NEXT_PUBLIC_API_URL="http://localhost:8000"

